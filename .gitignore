# Root .gitignore for PJU Tracking App

# OS & Editor
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Environment files
.env
.env.backup
.env.production
.env*.local

# Node & Frontend
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# PHP & Laravel
vendor/
*.sqlite*
backend/storage/*.key
backend/storage/pail
backend/bootstrap/cache/*.php
!backend/bootstrap/cache/.gitignore

# Logs
*.log
